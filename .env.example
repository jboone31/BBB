# ---------------------------------------------------------------------------
# Beltline Bar Brawl — environment configuration (EXAMPLE / template)
# ---------------------------------------------------------------------------
# This file is COMMITTED and contains only non-secret placeholder values.
# Copy it to a real, uncommitted env file and fill in actual values:
#
#   local        ->  .env.local        (your dev machine / dev Supabase project)
#   preview      ->  Vercel "Preview"  environment variables (per-branch/PR)
#   production   ->  Vercel "Production" environment variables
#
# All real env files (.env, .env.local, .env.*) are git-ignored; only this
# .env.example is committed. NEVER put real secrets in this file.
#
# Startup validation (lib/env) fails fast if any variable below is missing or
# empty and reports every offending name, so every variable here is REQUIRED.
# ---------------------------------------------------------------------------

# --- Public (browser-safe) -------------------------------------------------
# These NEXT_PUBLIC_* values are exposed to the client bundle. They are safe to
# ship to the browser. Use the values for the matching environment: your dev
# Supabase project locally, and the corresponding Supabase project for preview
# and production on Vercel.

# Base URL of the Supabase project (e.g. https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "anon" (anonymous / public) API key. Browser-safe; access is scoped
# by Row-Level Security. This is NOT the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only (NEVER sent to the browser) -------------------------------
# Privileged key used only by server routes. Must stay server-side: set it in
# .env.local for development and in Vercel's Preview/Production server env vars.
# Do not prefix it with NEXT_PUBLIC_ and never expose it to the client.

# Supabase service-role key. Bypasses Row-Level Security — treat as a secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string for TRANSACTION-CAPABLE server writes.
# Used only by server mutation routes (lib/db/server.ts) to run a domain write
# and its single game_event append in ONE transaction (atomic state+event,
# Req 4.3/4.4) — something the Supabase REST/JS client cannot do. Set it to the
# Supabase project's Postgres connection URL (Database settings -> Connection
# string; use the pooler/session URL for serverless). Server-only; never exposed
# to the browser.
#
# NOTE (follow-up): this variable is OPTIONAL at startup — loadEnv() does NOT
# require it, so DB-free deployments still boot. It is validated on demand the
# first time a server route opens a connection (lib/env requireServerDbUrl).
# Promote it into loadEnv()'s required set once every server mutation depends on
# it.
SUPABASE_DB_URL=postgres://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
